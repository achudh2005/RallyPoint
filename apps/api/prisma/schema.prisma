datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMIN
  SCORER
  PLAYER
  VIEWER
  UMPIRE
}

enum PlayerStatus {
  ACTIVE
  INACTIVE
  RETIRED
}

enum DominantHand {
  LEFT
  RIGHT
}

enum TeamType {
  SINGLES_ENTRY
  DOUBLES_PAIR
  CLUB_TEAM
}

enum TournamentFormat {
  KNOCKOUT
  ROUND_ROBIN
  GROUP_KNOCKOUT
}

enum TournamentCategory {
  MS
  WS
  MD
  WD
  XD
}

enum MatchType {
  SINGLES
  DOUBLES
  MIXED
}

enum MatchStatus {
  SCHEDULED
  LIVE
  COMPLETED
  RETIRED
  WALKOVER
}

enum MatchSideEnum {
  A
  B
}

enum MatchEventType {
  POINT
  UNDO
  SERVE_FAULT
  INTERVAL
  RETIRE
  WALKOVER
  GAME_END
  MATCH_END
}

enum RallyEndTypeEnum {
  SMASH
  DROP
  NET
  OUT
  UNFORCED_ERROR
  SERVICE_FAULT
  WINNER
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         UserRole  @default(VIEWER)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  player        Player?
  scoredMatches Match[]  @relation("ScorerMatches")

  @@map("users")
}

model Player {
  id           String        @id @default(cuid())
  userId       String?       @unique @map("user_id")
  firstName    String        @map("first_name")
  lastName     String        @map("last_name")
  displayName  String        @map("display_name")
  dateOfBirth  DateTime?     @map("date_of_birth")
  gender       String?
  nationality  String?
  dominantHand DominantHand? @map("dominant_hand")
  heightCm     Int?          @map("height_cm")
  weightKg     Int?          @map("weight_kg")
  photoUrl     String?       @map("photo_url")
  bio          String?
  phone        String?
  email        String?
  city         String?
  state        String?
  country      String?
  clubId       String?       @map("club_id")
  status       PlayerStatus  @default(ACTIVE)
  externalIds  Json?         @map("external_ids")
  deletedAt    DateTime?     @map("deleted_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  user                User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  club                Club?                  @relation(fields: [clubId], references: [id], onDelete: SetNull)
  history             PlayerProfileHistory[]
  teamMemberships     TeamMember[]
  matchParticipations MatchParticipant[]
  careerStats         PlayerCareerStats?
  formTrend           PlayerFormTrend?

  @@index([displayName])
  @@index([clubId])
  @@index([status])
  @@map("players")
}

model PlayerProfileHistory {
  id        String   @id @default(cuid())
  playerId  String   @map("player_id")
  snapshot  Json
  changedBy String   @map("changed_by")
  changedAt DateTime @default(now()) @map("changed_at")

  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@map("player_profile_history")
}

model Club {
  id        String    @id @default(cuid())
  name      String
  city      String?
  logoUrl   String?   @map("logo_url")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  players   Player[]

  @@map("clubs")
}

model Team {
  id        String       @id @default(cuid())
  name      String
  type      TeamType     @default(SINGLES_ENTRY)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  members    TeamMember[]
  matchSides MatchSide[]

  @@map("teams")
}

model TeamMember {
  id        String    @id @default(cuid())
  teamId    String    @map("team_id")
  playerId  String    @map("player_id")
  role      String?
  joinedAt  DateTime  @default(now()) @map("joined_at")
  leftAt    DateTime? @map("left_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([teamId, playerId, leftAt])
  @@map("team_members")
}

model Venue {
  id         String       @id @default(cuid())
  name       String
  address    String?
  latitude   Float?
  longitude  Float?
  courtCount Int          @default(1) @map("court_count")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  courts      Court[]
  tournaments Tournament[]

  @@map("venues")
}

model Court {
  id          String   @id @default(cuid())
  venueId     String   @map("venue_id")
  courtNumber Int      @map("court_number")
  surfaceType String?  @map("surface_type")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  venue   Venue   @relation(fields: [venueId], references: [id], onDelete: Cascade)
  matches Match[]

  @@unique([venueId, courtNumber])
  @@map("courts")
}

model Tournament {
  id        String             @id @default(cuid())
  name      String
  format    TournamentFormat   @default(KNOCKOUT)
  category  TournamentCategory @default(MS)
  startDate DateTime?          @map("start_date")
  endDate   DateTime?          @map("end_date")
  venueId   String?            @map("venue_id")
  status    String             @default("ACTIVE")
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  venue   Venue?  @relation(fields: [venueId], references: [id], onDelete: SetNull)
  matches Match[]

  @@map("tournaments")
}

model Match {
  id           String         @id @default(cuid())
  tournamentId String?        @map("tournament_id")
  courtId      String?        @map("court_id")
  matchType    MatchType      @default(SINGLES) @map("match_type")
  bestOf       Int            @default(3) @map("best_of")
  status       MatchStatus    @default(SCHEDULED)
  scheduledAt  DateTime?      @map("scheduled_at")
  startedAt    DateTime?      @map("started_at")
  endedAt      DateTime?      @map("ended_at")
  winnerSide   MatchSideEnum? @map("winner_side")
  scorerUserId String?        @map("scorer_user_id")
  clientUuid   String         @unique @map("client_uuid")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  tournament      Tournament?           @relation(fields: [tournamentId], references: [id], onDelete: SetNull)
  court           Court?                @relation(fields: [courtId], references: [id], onDelete: SetNull)
  scorer          User?                 @relation("ScorerMatches", fields: [scorerUserId], references: [id], onDelete: SetNull)
  sides           MatchSide[]
  participants    MatchParticipant[]
  games           Game[]
  events          MatchEvent[]
  analyticsRollup MatchAnalyticsRollup?

  @@index([status])
  @@map("matches")
}

model MatchSide {
  id      String        @id @default(cuid())
  matchId String        @map("match_id")
  side    MatchSideEnum
  teamId  String?       @map("team_id")

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team  Team? @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@unique([matchId, side])
  @@map("match_sides")
}

model MatchParticipant {
  id       String        @id @default(cuid())
  matchId  String        @map("match_id")
  side     MatchSideEnum
  playerId String        @map("player_id")
  position Int           @default(1)

  match  Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([matchId, side, position])
  @@map("match_participants")
}

model Game {
  id         String         @id @default(cuid())
  matchId    String         @map("match_id")
  gameNumber Int            @map("game_number")
  scoreA     Int            @default(0) @map("score_a")
  scoreB     Int            @default(0) @map("score_b")
  winnerSide MatchSideEnum? @map("winner_side")
  startedAt  DateTime       @default(now()) @map("started_at")
  endedAt    DateTime?      @map("ended_at")

  match  Match        @relation(fields: [matchId], references: [id], onDelete: Cascade)
  events MatchEvent[]

  @@unique([matchId, gameNumber])
  @@map("games")
}

model MatchEvent {
  id             String            @id
  matchId        String            @map("match_id")
  gameId         String?           @map("game_id")
  sequenceNumber Int               @map("sequence_number")
  eventType      MatchEventType    @map("event_type")
  side           MatchSideEnum?
  rallyEndType   RallyEndTypeEnum? @map("rally_end_type")
  serverPlayerId String?           @map("server_player_id")
  payload        Json?
  occurredAt     DateTime          @map("occurred_at")
  recordedAt     DateTime          @default(now()) @map("recorded_at")
  deviceId       String?           @map("device_id")

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  game  Game? @relation(fields: [gameId], references: [id], onDelete: SetNull)

  @@unique([matchId, sequenceNumber])
  @@index([matchId, sequenceNumber])
  @@index([occurredAt])
  @@map("match_events")
}

model PlayerCareerStats {
  playerId      String    @id @map("player_id")
  matchesPlayed Int       @default(0) @map("matches_played")
  matchesWon    Int       @default(0) @map("matches_won")
  matchesLost   Int       @default(0) @map("matches_lost")
  gamesWon      Int       @default(0) @map("games_won")
  gamesLost     Int       @default(0) @map("games_lost")
  pointsWon     Int       @default(0) @map("points_won")
  pointsLost    Int       @default(0) @map("points_lost")
  winRate       Float     @default(0.0) @map("win_rate")
  currentStreak Int       @default(0) @map("current_streak")
  bestStreak    Int       @default(0) @map("best_streak")
  lastPlayedAt  DateTime? @map("last_played_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  player        Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@map("player_career_stats")
}

model HeadToHead {
  id            String   @id @default(cuid())
  playerAId     String   @map("player_a_id")
  playerBId     String   @map("player_b_id")
  matchesPlayed Int      @default(0) @map("matches_played")
  aWins         Int      @default(0) @map("a_wins")
  bWins         Int      @default(0) @map("b_wins")
  gamesPlayed   Int      @default(0) @map("games_played")
  aGameWins     Int      @default(0) @map("a_game_wins")
  bGameWins     Int      @default(0) @map("b_game_wins")
  lastMatchId   String?  @map("last_match_id")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([playerAId, playerBId])
  @@index([playerAId])
  @@index([playerBId])
  @@map("head_to_head_stats")
}

model PlayerFormTrend {
  playerId                String   @id @map("player_id")
  recentResults           String   @default("[]") @map("recent_results")
  avgPointsPerGame        Float    @default(0.0) @map("avg_points_per_game")
  avgMatchDurationMinutes Float    @default(0.0) @map("avg_match_duration_minutes")
  updatedAt               DateTime @updatedAt @map("updated_at")

  player                  Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@map("player_form_trends")
}

model MatchAnalyticsRollup {
  matchId          String   @id @map("match_id")
  longestRally     Int      @default(0) @map("longest_rally")
  streakA          Int      @default(0) @map("streak_a")
  streakB          Int      @default(0) @map("streak_b")
  leadChanges      Int      @default(0) @map("lead_changes")
  comebackDeficits Json     @default("{}") @map("comeback_deficits")
  serveWinPctA     Float    @default(0.0) @map("serve_win_pct_a")
  serveWinPctB     Float    @default(0.0) @map("serve_win_pct_b")
  shotBreakdown    Json     @default("{}") @map("shot_breakdown")
  computedAt       DateTime @default(now()) @map("computed_at")

  match            Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@map("match_analytics_rollups")
}
