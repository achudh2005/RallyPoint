{
  "name": "rallypoint",
  "version": "1.3.1",
  "private": true,
  "description": "Advanced badminton point-tracking web app (PWA) with event-sourced engine",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run --workspaces --if-present build",
    "test": "npm run --workspaces --if-present test",
    "lint": "npm run --workspaces --if-present lint",
    "typecheck": "npm run --workspaces --if-present typecheck",
    "test:coverage": "npm run --workspaces --if-present test:coverage",
    "db:generate": "npm run --workspace=@rallypoint/db generate",
    "db:migrate": "npm run --workspace=@rallypoint/db migrate",
    "db:seed": "npm run --workspace=@rallypoint/db seed",
    "db:rebuild-stats": "npm run --workspace=@rallypoint/db rebuild-stats",
    "db:backfill-awards": "tsx packages/db/src/backfillStreaksAndMvp.ts",
    "seed:demo": "tsx packages/db/src/seedCommunityRankings.ts",
    "seed:community": "tsx packages/db/src/seedCommunityRankings.ts",
    "check:no-demo": "node scripts/check-no-demo-data.mjs",
    "rebuild-rankings": "tsx packages/ranking/src/cli.ts",
    "build:web": "npm run --workspace=@rallypoint/web build:web",
    "cap:sync": "npm run --workspace=@rallypoint/web cap:sync",
    "android:debug": "npm run --workspace=@rallypoint/web android:debug",
    "android:release": "npm run --workspace=@rallypoint/web android:release"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "canvas-confetti": "^1.9.4",
    "framer-motion": "^14.14.0"
  }
}
